                <p>{post.data.description}</p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state compact">
          <p set:html={t('home.postsEmpty')} />
        </div>
      )
    }
  </section> -->
</BaseLayout>
