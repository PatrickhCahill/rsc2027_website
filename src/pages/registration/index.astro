---
// Registration page. The prose here is placeholder copy — rewrite it for the
// event. Like the about page, it is intentionally *not* in `src/i18n/`: the
// dictionary holds UI chrome (title, eyebrow), the copy lives here.
//
// TODO (Phase 1): embed the Google Form via the `Embed` component once
// `EMBEDS.registrationForm` exists in `src/consts.ts`.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import { t } from '../../i18n';
---

<BaseLayout title={t('registration.title')} description={`Register for ${SITE.title}.`}>
  <section class="page-head section">
    <p class="eyebrow">{t('registration.eyebrow')}</p>
    <h1>Register to attend.</h1>
    <p class="lead">
      Registration details, deadlines, and the registration form will appear here.
    </p>
  </section>
</BaseLayout>