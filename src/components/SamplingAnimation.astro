---
// Hero splash: 50 normal samples stack into a histogram, then the density
// curve is drawn over them. A canvas port of the Manim scene that used to ship
// as SamplingNormalDistribution.mov, coloured from the theme tokens.
---

<canvas class="hero-video" aria-hidden="true"></canvas>

<script>
  type Point = [number, number];

  // Seeded PRNG (mulberry32) + Box–Muller, standing in for np.random.seed(42) / randn.
  // Reset to 42 on each start(), so every visit replays the same sequence of samples.
  let seed = 42;
  const rand = () => {
    let t = (seed = (seed + 0x6d2b79f5) | 0);
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 2 ** 32;
  };
  const randn = () => Math.sqrt(-2 * Math.log(1 - rand())) * Math.cos(2 * Math.PI * rand());

  // 50 samples snapped to the nearest of 15 bin centres on [-4, 4], stacked 0.1 apart,
  // shuffled, then ordered by row
  const N = 50;
  const BINS = 15;
  const BW = 8 / BINS;
  const sample = () => {
    const counts: number[] = new Array(BINS).fill(0);
    const pts = Array.from({ length: N }, (): Point => {
      const k = Math.min(BINS - 1, Math.max(0, Math.floor((randn() + 4) / BW)));
      return [-4 + BW * (k + 0.5), 0.1 * counts[k]++];
    });
    for (let i = N - 1; i > 0; i--) {
      const j = Math.floor(rand() * (i + 1));
      [pts[i], pts[j]] = [pts[j], pts[i]];
    }
    return pts.sort((a, b) => a[1] - b[1]);
  };

  // Timeline (s): Create(axes) 1s, once. Then a cycle per sample: one 0.1s Transform per dot,
  // Create(curve) 1s, wait, fade out, and repeat with a fresh sample. C_* are cycle-relative.
  const T_AXES = 1;
  const MOVE = 0.1;
  const C_CURVE = MOVE * N;
  const C_FADE = C_CURVE + 3;
  const CYCLE = C_FADE + 0.5;
  const sig = (x: number) => 1 / (1 + Math.exp(-x));
  const E = sig(-5);
  // Manim's default rate_func
  const smooth = (t: number) => (sig(10 * (Math.min(1, Math.max(0, t)) - 0.5)) - E) / (1 - 2 * E);
  // Everything settled: axes drawn, every dot of the first sample stacked, curve complete.
  const END = T_AXES + C_CURVE + 1;

  // Binds to the hero canvas on the current page. Runs on first load and after
  // every view-transition swap, because a return visit to Home via the router
  // brings in a fresh canvas but doesn't re-run this module.
  const start = () => {
    const cv = document.querySelector('canvas.hero-video');
    const ctx = cv instanceof HTMLCanvasElement ? cv.getContext('2d') : null;
    if (!(cv instanceof HTMLCanvasElement) || !ctx) return;

    // Theme colours, cached and re-read whenever the toggle flips `data-theme`.
    const theme = { axis: '', dot: '', dotStroke: '', curve: '', font: '' };
    const readTheme = () => {
      const css = getComputedStyle(cv);
      theme.axis = css.getPropertyValue('--color-line-strong');
      theme.dot = css.getPropertyValue('--color-text');
      theme.dotStroke = css.getPropertyValue('--color-surface');
      theme.curve = css.getPropertyValue('--color-accent');
      theme.font = css.getPropertyValue('--font-display');
    };
    readTheme();

    seed = 42;
    let pts = sample();
    let cycle = 0;

    // Renders the scene as it looks `t` seconds into the timeline, with `pts` as the
    // current cycle's sample.
    const draw = (t: number) => {
      const dpr = devicePixelRatio;
      const w = cv.clientWidth;
      const h = cv.clientHeight;
      if (cv.width !== Math.round(w * dpr) || cv.height !== Math.round(h * dpr)) {
        cv.width = Math.round(w * dpr);
        cv.height = Math.round(h * dpr);
      }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);

      // One Manim unit in px (frame is 14.2 × 8 units)
      const u = h / 8;
      // axes.c2p: x∈[-4,4] → 12 units, y∈[0,2] → 6 units
      const P = (x: number, y: number): Point => [w / 2 + 1.5 * x * u, h / 2 - (3 * y - 3) * u];

      // Axes: lines grow in, ticks/numbers fade in
      const a = smooth(t / T_AXES);
      ctx.strokeStyle = ctx.fillStyle = theme.axis;
      ctx.lineWidth = 0.02 * u;
      const axes: [number, number, number, number, number][] = [
        [-4, 0, 4, 0, 0],
        [0, 0, 0, 2, -Math.PI / 2],
      ];
      for (const [x0, y0, x1, y1, rot] of axes) {
        const [ax, ay] = P(x0, y0);
        const [bx, by] = P(x0 + (x1 - x0) * a, y0 + (y1 - y0) * a);
        const L = 0.25 * u;
        ctx.beginPath();
        ctx.moveTo(ax, ay);
        ctx.lineTo(bx, by);
        ctx.stroke();
        ctx.save();
        ctx.translate(bx, by);
        ctx.rotate(rot);
        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.lineTo(-L, L / 2);
        ctx.lineTo(-L, -L / 2);
        ctx.fill();
        ctx.restore();
      }
      ctx.globalAlpha = a;
      ctx.font = `${0.4 * u}px ${theme.font}`;
      const tick = (px: number, py: number, dx: number, dy: number) => {
        ctx.beginPath();
        ctx.moveTo(px - dx, py - dy);
        ctx.lineTo(px + dx, py + dy);
        ctx.stroke();
      };
      ctx.textAlign = 'center';
      ctx.textBaseline = 'top';
      for (let x = -4; x < 4; x++) {
        const [px, py] = P(x, 0);
        tick(px, py, 0, 0.1 * u);
        if (x) ctx.fillText(String(x).replace('-', '−'), px, py + 0.25 * u);
      }
      ctx.textAlign = 'right';
      ctx.textBaseline = 'middle';
      for (let y = 0; y < 2; y++) {
        const [px, py] = P(0, y);
        tick(px, py, 0.1 * u, 0);
        if (y) ctx.fillText(String(y), px - 0.25 * u, py);
      }
      ctx.globalAlpha = 1;
      if (t < T_AXES) return;

      // Time into the current cycle; dots and curve fade out together at its end
      const c = (t - T_AXES) % CYCLE;
      ctx.globalAlpha = 1 - smooth((c - C_FADE) / (CYCLE - C_FADE));

      // Dots: all start at c2p(-4, 1), then move to their stack one at a time
      ctx.fillStyle = theme.dot;
      ctx.strokeStyle = theme.dotStroke;
      ctx.lineWidth = 0.02 * u;
      const [sx, sy] = P(-4, 1);
      pts.forEach(([x, y], i) => {
        const [ex, ey] = P(x, y);
        const k = smooth(c / MOVE - i);
        ctx.beginPath();
        ctx.arc(sx + (ex - sx) * k, sy + (ey - sy) * k, 0.08 * u, 0, 2 * Math.PI);
        ctx.fill();
        ctx.stroke();
      });

      // Curve: exp(-x²/2) on [-3, 3], drawn left to right
      if (c >= C_CURVE) {
        const p = smooth(c - C_CURVE);
        ctx.strokeStyle = theme.curve;
        ctx.lineWidth = 0.04 * u;
        ctx.lineJoin = 'round';
        ctx.beginPath();
        for (let i = 0; i <= 100; i++) {
          const x = -3 + (6 * p * i) / 100;
          ctx.lineTo(...P(x, Math.exp((-x * x) / 2)));
        }
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
    };

    let raf = 0;
    let resize: ResizeObserver | undefined;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const themeObserver = new MutationObserver(() => {
      readTheme();
      if (still) draw(END);
    });
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    if (still) {
      // No loop to pick up layout or font changes, so redraw the final frame on
      // resize (which also fires once on observe) and once the tick font loads.
      resize = new ResizeObserver(() => draw(END));
      resize.observe(cv);
      document.fonts.load(`16px ${theme.font}`).then(() => draw(END));
    } else {
      let t0: number | undefined;
      const frame = (ms: number) => {
        t0 ??= ms;
        const t = (ms - t0) / 1000;
        // Catch up one sample per elapsed cycle (a background tab skips several),
        // so the sequence stays the same however the page was watched.
        const n = Math.max(0, Math.floor((t - T_AXES) / CYCLE));
        for (; cycle < n; cycle++) pts = sample();
        draw(t);
        raf = requestAnimationFrame(frame);
      };
      raf = requestAnimationFrame(frame);
    }

    // Stop before the router swaps this canvas out.
    document.addEventListener(
      'astro:before-swap',
      () => {
        cancelAnimationFrame(raf);
        themeObserver.disconnect();
        resize?.disconnect();
      },
      { once: true },
    );
  };

  start();
  document.addEventListener('astro:after-swap', start);
</script>
